{
  "name": "sqlsandbox",
  "version": "1.1.0",
  "description": "Learn SQL in a local sandbox — create databases, write queries, and visualize schemas.",
  "author": "Damion Wilson",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "audit:contrast": "node scripts/contrast-audit.mjs",
    "electron": "vite build && electron .",
    "dist": "vite build && electron-builder --win nsis"
  },
  "build": {
    "appId": "net.codeboxllc.sqlsandbox",
    "productName": "SQL Sandbox",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SQL Sandbox"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@uiw/codemirror-theme-vscode": "^4.25.12",
    "mermaid": "^12.2.0",
    "sql-formatter": "^15.9.0",
    "sql.js": "^1.14.2"
  }
}
